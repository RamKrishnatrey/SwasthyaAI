# SwasthyaAI Backend Environment Variables
# Copy to .env and adjust as needed

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS - Vite dev server origin, Expo Go, and mobile development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,exp://localhost:8081

# Database
DATABASE_URL=sqlite:///./swasthyaai.db

# Model (for future trained model integration)
MODEL_PATH=./models/triage_model
MODEL_SOURCE=mock  # "mock" or "trained"

# Safety
SAFETY_ESCALATION_ENABLED=true

# Ranking weights (must sum to 1.0)
WEIGHT_SKILL_FIT=0.35
WEIGHT_DISTANCE=0.25
WEIGHT_AVAILABILITY=0.20
WEIGHT_LANGUAGE=0.10
WEIGHT_RATING=0.10

# Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
REFRESH_TOKEN_EXPIRE_DAYS=30

# TinyFish API
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://api.tinyfish.ai