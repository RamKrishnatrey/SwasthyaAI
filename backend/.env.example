# SwasthyaAI Backend Environment Variables
# Copy to .env and adjust as needed

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS - Vite dev server origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./swasthyaai.db

# Model (for future trained model integration)
MODEL_PATH=./models/triage_model
MODEL_SOURCE=mock  # "mock" or "trained"

# Safety
SAFETY_ESCALATION_ENABLED=true

# Ranking weights (must sum to 1.0)
WEIGHT_SKILL_FIT=0.35
WEIGHT_DISTANCE=0.25
WEIGHT_AVAILABILITY=0.20
WEIGHT_LANGUAGE=0.10
WEIGHT_RATING=0.10