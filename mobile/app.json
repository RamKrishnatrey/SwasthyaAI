{
  "expo": {
    "name": "SwasthyaAI",
    "slug": "swasthyaai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F3D3E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swasthyaai.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SwasthyaAI needs microphone access for voice input",
        "NSSpeechRecognitionUsageDescription": "SwasthyaAI uses speech recognition for voice commands",
        "NSPhotoLibraryUsageDescription": "SwasthyaAI needs photo library access for medical document uploads",
        "NSCameraUsageDescription": "SwasthyaAI needs camera access for medical document scanning"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F3D3E"
      },
      "package": "com.swasthyaai.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-av",
      "expo-speech",
      "expo-image-picker",
      "expo-document-picker",
      "expo-notifications",
      "expo-secure-store",
      "expo-location",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    },
    "owner": "your-expo-username"
  }
}